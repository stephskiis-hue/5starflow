generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stores the connected Jobber account's OAuth tokens.
// Multi-tenant: one row per Jobber org, linked to the portal User who connected it.
model JobberAccount {
  id           String   @id @default(cuid())
  accountId    String   @unique  // Jobber account/org ID from token response
  userId       String?           // portal User.id — links this Jobber org to a portal user
  accessToken  String
  refreshToken String
  expiresAt    DateTime           // UTC: when the access token expires
  webhookId    String?            // Jobber webhook endpoint ID once registered
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Audit log for every token refresh attempt (success or failure).
// Powers the /api/token-logs endpoint and dashboard health monitor.
model TokenRefreshLog {
  id        String   @id @default(cuid())
  accountId String                   // Jobber account ID (for reference)
  success   Boolean                  // true = refreshed OK, false = failed
  message   String                   // e.g. "Token refreshed" or error text
  trigger   String   @default("scheduler") // "scheduler" | "on-demand"
  createdAt DateTime @default(now())
}

// Tracks which clients have already received a review request.
// Secondary deduplication layer in case Jobber tag API is temporarily down.
model ReviewSent {
  id        String   @id @default(cuid())
  clientId  String   @unique  // Jobber EncodedId of the client
  invoiceId String             // Invoice that triggered the send
  accountId String?            // Jobber account ID — for per-account visibility
  sentAt    DateTime @default(now())
}

// Portal users — email must match the license email used to purchase.
// Create the first user via POST /auth/setup-user with the SETUP_TOKEN.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         String   @default("client")  // "admin" | "client"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

}

// Delay queue: invoices queued for review request, sent after REVIEW_DELAY_MINUTES.
// invoiceId is unique so webhook retries and poller duplicates are silently ignored.
model PendingReview {
  id          String   @id @default(cuid())
  invoiceId   String   @unique  // Jobber invoice ID — idempotency key
  clientId    String
  clientName  String
  firstName   String
  phone       String?           // null if client has no primary phone
  smsAllowed  Boolean  @default(false)
  email       String?           // null if client has no primary email
  scheduledAt DateTime          // when to send = enqueued time + REVIEW_DELAY_MINUTES
  processed            Boolean   @default(false)
  cancelled            Boolean   @default(false)
  channel              String?             // "sms" | "email" — which channel was used for initial send
  followUpScheduledAt  DateTime?           // set after initial send if client has email (now + 24h)
  followUpSent         Boolean   @default(false)
  userId               String?             // portal user who owns this queued review
  createdAt            DateTime  @default(now())

  @@index([processed, cancelled, scheduledAt])
  @@index([userId])
}

// Daily weather check log — one row per morning check run.
model WeatherCheck {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD
  rainExpected    Boolean
  maxPrecipProb   Float    // 0.0–1.0 (highest pop in business hours)
  forecastSummary String   // e.g. "Rain likely 9am–2pm (72%)"
  userId          String?  // portal user who owns this check
  checkedAt       DateTime @default(now())

  @@index([userId])
}

// Audit log for every rain reschedule batch notification sent.
model RainReschedule {
  id           String   @id @default(cuid())
  originalDay  String   // "monday"
  originalDate String   // YYYY-MM-DD
  newDate      String   // YYYY-MM-DD
  clientCount  Int
  smsCount     Int      @default(0)
  emailCount   Int      @default(0)
  message      String   // actual message text that was sent
  userId       String?  // portal user who owns this reschedule
  notifiedAt   DateTime @default(now())

  @@index([userId])
}

// Per-client, per-channel log for every rain reschedule message sent.
model RainMessage {
  id            String   @id @default(cuid())
  rescheduleId  String   // FK to RainReschedule.id
  visitId       String
  clientId      String
  clientName    String
  channel       String   // "sms" | "email"
  status        String   @default("sent")  // "sent" | "failed" | "delivered" | "undelivered"
  messageSid    String?  // Twilio message SID (for delivery callbacks)
  error         String?  // error message if status is "failed"
  sentAt        DateTime @default(now())
  userId        String?

  @@index([rescheduleId])
  @@index([userId])
}

// Per-user settings row for the weather/rain feature.
model WeatherSettings {
  id                     String  @id @default(cuid())
  userId                 String? @unique  // one row per user
  city                   String  @default("Winnipeg")
  rainThreshold          Float   @default(0.4)   // 40% pop = rain warning
  businessStartHour      Int     @default(7)
  businessEndHour        Int     @default(18)
  preferredRescheduleDay String  @default("")    // saved dropdown value (YYYY-MM-DD)
  checkEnabled           Boolean @default(true)
  rainSmsTemplate        String  @default("")    // user-saved SMS template; supports {firstName} and {newDate}
}

// SEO: one row per weekly audit run.
model SeoAudit {
  id               String   @id @default(cuid())
  siteUrl          String
  status           String   @default("running")  // running | complete | failed
  performanceScore Int?
  lcp              Float?   // Largest Contentful Paint (s)
  cls              Float?   // Cumulative Layout Shift
  fid              Float?   // First Input Delay (ms)
  keywordsJson     String?  // JSON array: [{ keyword, clicks, impressions, position }]
  competitorJson   String?  // JSON array: [{ url, title, h1s, wordCount, schema }]
  insightJson      String?  // JSON array: generated insights
  userId           String?  // portal user who owns this audit
  runAt            DateTime @default(now())

  @@index([userId])
}

// SEO: one proposal per audit — operator approves or declines.
model SeoProposal {
  id          String    @id @default(cuid())
  auditId     String
  status      String    @default("pending")  // pending | approved | declined
  title       String
  summaryJson String    // JSON array: [{ insight, impact, fix, fileTarget }]
  userId      String?   // portal user who owns this proposal
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// SEO: individual file changes attached to a proposal.
model SeoChange {
  id          String    @id @default(cuid())
  proposalId  String
  filePath    String
  oldContent  String
  newContent  String
  description String
  status      String    @default("pending")  // pending | applied | failed
  userId      String?   // portal user who owns this change
  appliedAt   DateTime?
  errorMsg    String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Website Audit: FTP server credentials — one config per user.
model FtpConfig {
  id                String   @id @default(cuid())
  userId            String?  // portal user who owns this config
  host              String
  user              String
  encryptedPassword String
  rootPath          String   @default("/public_html")
  port              Int      @default(21)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// Website Audit: path patterns to exclude from FTP scans (e.g. "cgi-bin", "wp-admin").
model AuditIgnore {
  id        String   @id @default(cuid())
  pattern   String
  userId    String?  // portal user who owns this ignore rule
  createdAt DateTime @default(now())

  @@unique([userId, pattern])
  @@index([userId])
}

// Website Audit: one row per HTML file discovered on the FTP server.
// Status flow: discovered → pulled → auditing → audited → edited → pushed → done
model AuditPage {
  id              String    @id @default(cuid())
  path            String    // full remote path e.g. /public_html/about.html
  filename        String
  status          String    @default("discovered")
  localContent    String?             // raw HTML pulled from server
  userId          String?             // portal user who owns this page
  lastPulled      DateTime?
  lastPushed      DateTime?
  auditScore      Int?                // composite 0-100 (SEO + perf)
  seoScore        Int?
  perfScore       Int?
  auditIssuesJson String?             // JSON: [{ type, severity, message, fix }]
  pageUrl         String?             // full public URL for PageSpeed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, path])
  @@index([userId])
}

// SEO: per-user settings row — site URL, competitors, deploy config, Google tokens.
model SeoSettings {
  id                 String   @id @default(cuid())
  userId             String?  @unique  // one row per user
  siteUrl            String   @default("")
  competitorUrls     String   @default("[]")   // JSON array of competitor URLs
  deployType         String   @default("none") // "git" | "ftp" | "none"
  deployHost         String?
  deployPort         Int?
  deployUser         String?
  deployPass         String?
  deployPath         String?
  deployBranch       String   @default("main")
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  siteProperty       String?  // Search Console property e.g. "sc-domain:nobsyardwork.com"
  ga4PropertyId      String?  // GA4 property ID e.g. "properties/123456789"
  auditEnabled       Boolean  @default(true)
  deepAnalysis       Boolean  @default(false) // true = Sonnet (~4¢), false = Haiku (~0.7¢)
  growthConfig       Json?    // SEO Growth Engine knobs the owner can change (ai/seo/config.js mergeConfig)
  growthState        Json?    // SEO Growth Engine machine state: sync cursors, Serper budget, inspection counts
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

// Per-user Twilio SMS credentials.
model TwilioCredential {
  id          String   @id @default(cuid())
  userId      String   @unique  // one row per user
  accountSid  String
  authToken   String
  fromNumber  String
  // Optional Twilio Messaging Service SID (MG...). When set it is used INSTEAD of
  // fromNumber: Twilio then picks a sender from the service's pool, so throughput
  // scales with the number of senders instead of being capped at one long code's
  // ~1 segment/sec, and Twilio manages the send queue itself.
  messagingServiceSid String?
  notifyPhone String?           // admin's personal mobile — gets SMS when client replies Y/N
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Loyalty & Referral Engine — tracks client points, referral slugs, and multiplier flags.
// One row per (userId, jobberClientId) pair. optedOut=true excludes from leaderboard.
model LoyaltyClient {
  id                   String   @id @default(cuid())
  userId               String                          // portal User.id who owns this record
  jobberClientId       String                          // Jobber encoded client ID
  displayName          String                          // "First L." privacy format
  totalPoints          Int      @default(0)
  referralSlug         String   @unique                // short unique token, e.g. "jd-a8f3"
  hasPendingMultiplier Boolean  @default(false)        // next invoice earns 20 pts instead of 10
  optedOut             Boolean  @default(false)        // client requested removal from game
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, jobberClientId])
  @@index([userId])
}

// PageSpeed score history — one row per Free Site Score run.
model PageSpeedHistory {
  id           String   @id @default(cuid())
  userId       String?
  siteUrl      String
  mobileScore  Int?
  desktopScore Int?
  mobileSeo    Int?
  lcp          Float?
  cls          Float?
  fid          Float?
  issuesJson   String?  // JSON: [{ id, category, title, score, savings }]
  runAt        DateTime @default(now())

  @@index([userId])
}

// Per-user message customization for review request emails and SMS.
model MessageSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  businessName    String   @default("My Business")
  tagline         String   @default("")
  logoUrl         String   @default("")
  reviewLink      String   @default("")
  buttonColor     String   @default("#1b5e20")
  emailSubject    String   @default("Could you do us a small favor?")
  emailBody       String   @default("We hope you're loving the results! We'd love to hear what you think.")
  emailCustomHtml String   @default("")
  smsBody         String   @default("")
  updatedAt       DateTime @updatedAt
}

// Per-user Gmail credentials for outbound email (Google OAuth2).
model GmailCredential {
  id           String    @id @default(cuid())
  userId       String    @unique  // one row per user
  gmailUser    String              // connected Gmail address
  fromName     String    @default("")
  accessToken  String    @default("")
  refreshToken String?
  tokenExpiry  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Read-only Google Drive connection the vault imports photos from.
model DriveCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String
  accessToken       String    @default("")
  refreshToken      String?
  tokenExpiry       DateTime?
  lastSyncAt        DateTime?
  backfillPageToken String?                // next page of older photos; null once the whole Drive was walked
  backfillDone      Boolean   @default(false)
  importedCount     Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MessageTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

// Tracks when each integration was last successfully verified (test passed or OAuth connected).
// Green checkmark only shows when a record exists here.
model ConnectionVerification {
  id         String   @id @default(cuid())
  userId     String
  service    String   // 'jobber' | 'gmail' | 'twilio' | 'openweather' | 'pagespeed'
  verifiedAt DateTime @default(now())

  @@unique([userId, service])
}

// ---------------------------------------------------------------------------
// SMS Marketing System
// ---------------------------------------------------------------------------

// Reusable SMS message templates. Supports {firstName} placeholder.
model MarketingTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Named audience list — a saved set of contacts imported from Jobber.
model AudienceList {
  id        String            @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  contacts  AudienceContact[]

  @@index([userId])
}

// Join table: one row per contact in an audience list (snapshot at import time).
model AudienceContact {
  id             String       @id @default(cuid())
  audienceListId String
  audienceList   AudienceList @relation(fields: [audienceListId], references: [id], onDelete: Cascade)
  jobberClientId String
  clientName     String
  firstName      String
  phone          String?
  smsAllowed     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([audienceListId, jobberClientId])
  @@index([audienceListId])
}

// One campaign = one send job (template + audience). messageBody is frozen snapshot.
model MarketingCampaign {
  id              String             @id @default(cuid())
  userId          String
  name            String
  templateId      String
  audienceListId  String
  messageBody     String
  status          String             @default("pending")
  totalRecipients Int                @default(0)
  sentCount       Int                @default(0)
  failedCount     Int                @default(0)
  skippedCount    Int                @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  messages        MarketingMessage[]

  @@index([userId])
}

// Per-recipient delivery log within a campaign.
// Source of truth for "did this message go out?" — bulletproof SMS:
//   body           frozen resolved message text (so template edits post-start don't affect in-flight)
//   attempts       number of send attempts so far
//   nextRetryAt    when the retry worker should try again (status='retrying' only)
//   lastAttemptAt  wall-clock of most recent attempt (success or failure)
//   userId         denormalized from campaign for fast cron worker queries
model MarketingMessage {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId          String?           // denormalized for cron queries — matches campaign.userId
  jobberClientId  String
  clientName      String
  firstName       String
  phone           String?
  body            String            @default("")  // resolved message body ({firstName} replaced)
  segments        Int               @default(1)   // SMS segments this body costs (see calculateSegments)
  encoding        String?           // "GSM-7" | "UCS-2" — what forced the segment count

  // --- Dispatch state: OUR lifecycle, written only by the dispatcher/retry worker ---
  // pending | queued | failed | retrying | skipped
  //   queued = Twilio ACCEPTED the API call and returned a SID. It is NOT delivered.
  //   Legacy rows may still carry "sent", which means exactly the same thing.
  status          String            @default("pending")
  attempts        Int               @default(0)
  messageSid      String?
  error           String?
  sentAt          DateTime?         // when Twilio accepted the API call (NOT delivery time)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?

  // --- Delivery state: TWILIO's lifecycle, written only by the status callback ---
  // null (no receipt yet) | queued | sending | sent | delivered | undelivered | failed
  deliveryStatus   String?
  deliveredAt      DateTime?        // set when deliveryStatus first becomes "delivered"
  carrierErrorCode String?          // Twilio ErrorCode from the receipt (e.g. 30007 carrier filtered)

  replyBody       String?           // client's reply text (set when inbound SMS is matched)
  replyReceivedAt DateTime?         // when the reply arrived
  createdAt       DateTime          @default(now())

  @@index([campaignId])
  @@index([messageSid])
  @@index([campaignId, status])
  @@index([status, nextRetryAt])
  @@index([userId, status])
  @@index([phone, status])
  @@index([campaignId, deliveryStatus])
}

// ---------------------------------------------------------------------------
// Cached Jobber Clients — populated by background sync service (jobberClientSync.js)
// Replaces live-on-demand Jobber API calls in the audience builder.
// ---------------------------------------------------------------------------
model CachedJobberClient {
  id             String    @id @default(cuid())
  userId         String                          // portal User.id (matches JobberAccount.userId)
  jobberClientId String                          // Jobber's own client GID
  name           String
  firstName      String
  phone          String?
  smsAllowed     Boolean   @default(false)
  tags           String    @default("[]")        // JSON array stored as string
  optedOut       Boolean   @default(false)       // true if client texted STOP
  optedOutAt     DateTime?                       // when they opted out
  syncedAt       DateTime  @default(now())

  @@unique([userId, jobberClientId])
  @@index([userId])
  @@index([userId, phone])
}

// ---------------------------------------------------------------------------
// Inbound SMS — every message received on the Twilio marketing number.
// Linked to CachedJobberClient and the most recent campaign that texted them.
// ---------------------------------------------------------------------------
model InboundSMS {
  id             String   @id @default(cuid())
  userId         String                          // portal user whose Twilio number received this
  from           String                          // E.164 sender phone
  body           String                          // raw message text
  messageSid     String   @unique               // Twilio MessageSid (dedup guard)
  isResponse     Boolean  @default(false)        // true if body is Y/N/YES/NO
  response       String?                         // normalized: "yes" | "no" | null
  sentiment      String?                         // "promoter" | "neutral" | "detractor" (rule-based, client replies only)
  clientName     String?                         // matched from CachedJobberClient (or null)
  jobberClientId String?                         // matched client ID (or null)
  campaignId     String?                         // most recent campaign that texted this number
  notified       Boolean  @default(false)        // has admin been notified via SMS?
  read           Boolean  @default(false)        // has admin viewed in the Inbox tab?
  receivedAt     DateTime @default(now())

  @@index([userId])
  @@index([from])
  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// AppLog — structured log store. One row per notable event.
// Powers the Logs UI so Steph can audit SMS/email/webhook/jobber activity
// without SSH'ing into Railway.
//   category: sms | email | campaign | webhook | jobber | weather | auth | server
//   level:    info | warn | error
//   context:  JSON payload with campaignId, phone, errorCode, durationMs, etc.
// ---------------------------------------------------------------------------
model AppLog {
  id        String   @id @default(cuid())
  userId    String?
  category  String
  level     String
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([category, level, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Autonomous Operator — proposals generated by scheduled Claude runs.
// Tier "auto" = executed immediately (logged only). Tier "approval_required"
// = SMS sent to owner, YES/NO <shortCode> reply approves/declines.
// shortCode is the SMS-friendly 4-digit id unique per user.
// ---------------------------------------------------------------------------
model OperatorProposal {
  id            String    @id @default(cuid())
  userId        String                                    // portal User.id who owns this proposal
  shortCode     String                                    // zero-padded numeric id for SMS, e.g. "0127"
  createdAt     DateTime  @default(now())
  category      String                                    // "ad" | "seo" | "client_recovery" | "social_post" | "quote" | "email" | "review_response" | "other"
  tier          String                                    // "auto" | "approval_required"
  summary       String                                    // <=160 chars SMS body
  payload       Json                                      // full action spec (zapier channel, body, target, etc.)
  status        String    @default("pending")             // pending | approved | declined | expired | executed | failed
  smsSentAt     DateTime?
  smsMessageSid String?
  respondedAt   DateTime?
  respondedVia  String?                                   // "sms" | "manual"
  executedAt    DateTime?
  result        Json?                                     // outcome payload (zapier response, error, etc.)
  expiresAt     DateTime
  dedupKey      String?                                   // idempotency key so a re-run doesn't propose the same thing twice
  routineSlug   String?                                   // which Routine/agent created it
  runId         String?                                   // RoutineRun.id that created it
  createdBy     String?                                   // agent name or "owner"

  @@unique([userId, shortCode])
  @@unique([userId, dedupKey])
  @@index([userId, status])
  @@index([status, expiresAt])
}

// ---------------------------------------------------------------------------
// AI Operating System — registry, run ledger, tasks, memory, activity.
// Every background job and every Claude routine is a Routine; every execution is a RoutineRun.
// All rows are scoped by userId (the portal tenant). See backend/ai/*.
// ---------------------------------------------------------------------------

// One registry row per routine (backend scheduler, Claude cloud routine, desktop routine, Zapier action).
model Routine {
  id                   String       @id @default(cuid())
  userId               String
  slug                 String                                  // stable kebab-case id, e.g. "jobber-token-refresh"
  name                 String
  kind                 String                                  // backend | claude_cloud | claude_desktop | zapier | local_ollama
  agent                String       @default("system")         // orchestrator | communication | operations | research | content | design | social | qa | system
  category             String       @default("operations")
  purpose              String       @default("")
  trigger              String       @default("schedule")       // schedule | webhook | manual | event
  schedule             String?                                 // cron string or human-readable
  timezone             String       @default("America/Winnipeg")
  enabled              Boolean      @default(true)
  expectedEveryMinutes Int?                                    // heartbeat: longest acceptable gap between runs (null = not monitored)
  approvalRequired     Boolean      @default(false)
  learningEnabled      Boolean      @default(true)
  researchEnabled      Boolean      @default(false)
  autonomy             String       @default("approve")        // read | draft | approve | execute
  externalId           String?                                 // Claude routine trigger id (trig_...)
  config               Json?                                   // inputs/outputs/retry policy/notes
  lastRunAt            DateTime?
  lastStatus           String?
  lastSummary          String?
  lastError            String?
  nextRunAt            DateTime?
  consecutiveFailures  Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  runs                 RoutineRun[]

  @@unique([userId, slug])
  @@index([userId, agent])
}

// One row per execution. result holds the standard structured return value.
model RoutineRun {
  id                String    @id @default(cuid())
  routineId         String
  routine           Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  userId            String
  status            String    @default("running")             // running | completed | failed | skipped | missed
  trigger           String    @default("schedule")            // schedule | manual | api | heartbeat
  source            String    @default("backend")             // backend | claude
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  summary           String?
  itemsFound        Int?
  requiresAttention Int?
  result            Json?                                     // { items_found, requires_attention, high_priority, summary, actions_taken[], learnings[], research_findings[], items[] }
  errorClass        String?                                   // rate_limit | throttled | auth | network | validation | unknown
  error             String?

  @@index([routineId, startedAt])
  @@index([userId, startedAt])
  @@index([userId, status])
}

// Things that need a human. dedupKey makes creation idempotent ("never create duplicate tasks").
model Task {
  id               String    @id @default(cuid())
  userId           String
  dedupKey         String
  title            String
  reason           String    @default("")
  source           String    @default("system")                // sms | gmail | website | routine | social | opslog | owner ...
  customerName     String?
  customerKey      String?                                     // jobberClientId, phone or email
  context          Json?
  whatHappened     String    @default("")
  whatNeeds        String    @default("")
  recommended      String    @default("")
  proposedResponse String    @default("")
  urgency          String    @default("normal")                // low | normal | high | urgent
  status           String    @default("NEW")                   // NEW | IN_PROGRESS | WAITING | APPROVAL | COMPLETED | DISMISSED
  agent            String?
  routineSlug      String?
  timesFlagged     Int       @default(1)
  firstFlaggedAt   DateTime  @default(now())
  lastFlaggedAt    DateTime  @default(now())
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, dedupKey])
  @@index([userId, status])
  @@index([userId, urgency, status])
}

// Owner → agent requests typed on the dashboard home page. body is owner-written only;
// the request-inbox routine claims them and may only write status/response/runId.
model OwnerRequest {
  id          String    @id @default(cuid())
  userId      String
  body        String
  attachments Json?                                           // vault ContentAsset ids (photos/videos) the owner attached
  source      String    @default("dashboard")              // dashboard | sms (texted from the owner's phone; outcome is texted back)
  status      String    @default("pending")                // pending | working | done | needs_owner | failed | cancelled
  claimedAt   DateTime?
  claimedBy   String?
  response    String    @default("")
  runId       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

// Selective, durable knowledge. Upsert-only by (userId, scope, key) so it can't fill with duplicates.
model Memory {
  id         String    @id @default(cuid())
  userId     String
  scope      String                                            // business | brand | customer:<id> | agent:<name> | routine:<slug> | channel:<name> | group:<id> | rule
  key        String
  value      String
  confidence Float     @default(0.8)
  source     String?                                           // run id, task id, "owner", "opslog-import"
  agent      String?
  hits       Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, scope, key])
  @@index([userId, scope])
}

// Human-readable "what has 5StarFlow been doing" feed (separate from the technical AppLog).
model AgentActivity {
  id          String   @id @default(cuid())
  userId      String
  agent       String
  routineSlug String?
  runId       String?
  action      String                                           // short verb phrase: "posted to group", "created task", "rendered graphic"
  summary     String
  source      String?                                          // sms | gmail | facebook | jobber | system ...
  result      String?                                          // ok | failed | skipped | pending_approval
  tool        String?
  approval    String?                                          // none | auto | approved | pending | rejected
  learning    String?
  customerRef String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, agent, createdAt])
}

// ---------------------------------------------------------------------------
// Content engine + social (M2). Vault = the owner's real photos and every rendered graphic.
// ---------------------------------------------------------------------------

// Photos, rendered graphics, logos, references. Bytes live in Postgres (small business scale; dedup by sha256).
model ContentAsset {
  id            String   @id @default(cuid())
  userId        String
  kind          String   @default("photo")                   // photo | graphic | logo | reference | screenshot
  name          String
  mime          String
  bytes         Bytes
  size          Int
  sha256        String
  width         Int?
  height        Int?
  tags          String   @default("[]")                      // JSON array: PATIOS, SOD, FALL, BEFORE, AFTER, CREW ...
  source        String   @default("upload")                  // upload | render | import
  notes         String?
  contentItemId String?                                      // set for rendered graphics
  quality       Int?                                         // 1-5 curator score; renders only use >= 3
  private       Boolean  @default(false)                     // faces, plates, house numbers: never used on posts
  pairKey       String?                                      // groups before/after candidates (same job + day)
  driveFileId   String?                                      // Google Drive file it was imported from
  originalId    String?                                      // enhanced copy → its untouched original (kind "original")
  edits         String?                                      // JSON of the enhancement applied
  createdAt     DateTime @default(now())

  @@unique([userId, sha256])
  @@unique([userId, driveFileId])
  @@index([userId, kind])
  @@index([contentItemId])
}

// One piece of marketing content from idea to measured result.
model ContentItem {
  id            String    @id @default(cuid())
  userId        String
  status        String    @default("draft")                  // idea | draft | rendered | qa_failed | queued | approved | published | rejected | failed
  title         String
  pillar        String?                                      // tip | proof | review | faq | offer | founder | story | group | seasonal
  format        String    @default("post")                   // post | carousel | story | reel_cover | group_post
  layout        String?                                      // design-system layout name
  platforms     String    @default("[\"facebook\"]")         // JSON array: facebook | instagram | group
  slots         Json?                                        // renderer slots; carousels: { slides: [{layout, slots}] }
  caption       String    @default("")                       // Facebook / group text
  captionIg     String?                                      // Instagram caption incl. hashtags
  groupId       String?                                      // SocialGroup.id for group posts
  assetIds      Json?                                        // rendered ContentAsset ids, in order
  qa            Json?                                        // { ok, errors[], warnings[] }
  grounding     String?                                      // where the facts came from (real review URL, blog post, job)
  source        String?                                      // routine slug that created it
  scheduledFor  DateTime?
  approvedAt    DateTime?
  publishedAt   DateTime?
  postUrl       String?
  publishedOn   Json?                                        // { facebook: { postUrl, at }, instagram: { ... } } — one entry per platform actually posted
  metrics       Json?                                        // { reach, reactions, comments, shares, leads, capturedAt }
  note          String?                                      // owner's edit/reject note, fed back to the Content Director
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, scheduledFor])
}

// Facebook groups (and similar communities): rules, promo policy and what we've learned.
model SocialGroup {
  id             String    @id @default(cuid())
  userId         String
  platform       String    @default("facebook")
  name           String
  url            String?
  location       String?
  audience       String?
  relevance      Int       @default(3)                       // 1-5, how useful for leads
  membership     String    @default("unknown")               // unknown | requested | member | declined | left | banned
  rules          String    @default("")
  promoPolicy    String    @default("unknown")               // unknown | allowed | restricted | banned
  promoNotes     String    @default("")                      // e.g. "promo posts Fri-Sun only"
  cooldownDays   Int       @default(14)
  topics         String    @default("")
  notes          String    @default("")
  leads          Int       @default(0)
  postsCount     Int       @default(0)
  lastCheckedAt  DateTime?
  lastPostedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, platform, name])
  @@index([userId, membership])
}

// Every outward social action. Daily caps are enforced against this table (GET /social/budget).
model SocialAction {
  id            String   @id @default(cuid())
  userId        String
  platform      String                                       // facebook | instagram
  kind          String                                       // comment | dm | like | follow | group_join | group_post | page_post | story | reply
  target        String?
  groupId       String?
  contentItemId String?
  summary       String   @default("")
  status        String   @default("done")                    // reserved | done | failed | skipped | unverified
  url           String?                                      // link to OUR result (the comment / post / join)
  text          String?                                      // the exact words posted (what the server linted)
  expiresAt     DateTime?                                    // reserved rows stop counting against the cap after this
  shiftId       String?
  createdAt     DateTime @default(now())

  @@index([userId, platform, kind, createdAt])
  @@index([userId, createdAt])
  @@index([userId, groupId])
}

// A lead conversation the Social agent started or joined. Drives follow-ups (2 to 5 days later) and "already handled" checks.
model SocialThread {
  id              String    @id @default(cuid())
  userId          String
  platform        String    @default("facebook")
  url             String                                     // the post / conversation link, unique per user
  person          String    @default("")
  need            String    @default("")                     // service asked about
  neighbourhood   String    @default("")
  source          String    @default("")                     // inbox | search | group:<name> | hashtag
  status          String    @default("open")                 // open | quoted | followed | won | lost | held
  jobberRequestId String?
  notes           String    @default("")
  followedUpAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, url])
  @@index([userId, status, createdAt])
}

// One scheduled run of the Social agent on the MSI (morning | midday | evening | studio) for one Winnipeg day.
// The MSI gate asks the server what is due, claims it, runs Claude, and the server records the outcome.
model SocialShift {
  id         String    @id @default(cuid())
  userId     String
  day        String                                          // YYYY-MM-DD, Winnipeg
  kind       String                                          // morning | midday | evening | studio
  status     String    @default("due")                       // due | running | done | failed | needs_owner
  attempts   Int       @default(0)
  claimedAt  DateTime?
  finishedAt DateTime?
  summary    String?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, day, kind])
  @@index([userId, day])
}

// ---------------------------------------------------------------------------
// Communication ledger (M3) — every SMS in and out, with WHO sent it. "Waiting on No-Bs" is computed
// from this: only a human reply (source manual/owner) answers a customer; campaigns, review requests,
// rain notices and loyalty texts are automated and do not.
// ---------------------------------------------------------------------------
model CommMessage {
  id             String   @id @default(cuid())
  userId         String
  channel        String   @default("sms")               // sms | email | textnow
  direction      String                                  // in | out
  phone          String?                                 // E.164
  phoneKey       String?                                 // last 10 digits, for joins
  email          String?
  jobberClientId String?
  clientName     String?
  body           String   @default("")
  source         String   @default("system")             // inbound | campaign | review | rain | loyalty | reward | optout | operator | manual | owner | ai | system
  sourceId       String?                                 // InboundSMS.id, MarketingMessage.id, Twilio sid ...
  providerId     String?                                 // Twilio MessageSid
  status         String?
  at             DateTime @default(now())

  @@unique([userId, channel, direction, providerId])
  @@index([userId, phoneKey, at])
  @@index([userId, direction, at])
}

// What the Communication agent understood about a TextNow thread and what it WOULD have done (Phase 1 is read-only).
// When the owner then answers the thread himself, ownerReply/agreement record how close the draft was; per-intent
// agreement is what earns an intent more autonomy (config.intentAutonomy on the ext-textnow-insight routine).
model CommInsight {
  id             String    @id @default(cuid())
  userId         String
  channel        String    @default("textnow")
  phoneKey       String                                   // last 10 digits
  jobberClientId String?
  lastInboundId  String                                   // CommMessage.providerId of the customer message this is about
  intent         String                                   // cancel_visit | skip_visit | reschedule | schedule_question | quote_request | access_info | complaint | billing | praise | ack | other
  confidence     Float     @default(0.5)
  summary        String    @default("")
  proposedReply  String    @default("")
  proposedAction Json?
  ownerReply     String?
  ownerReplyAt   DateTime?
  agreement      String?                                  // match | partial | miss
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, channel, lastInboundId])
  @@index([userId, channel, createdAt])
  @@index([userId, intent])
}

// Owner notification centre: every routine/event lands here; only urgent ones are also texted.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  category    String    @default("system")  // routine | approval | customer | weather | request | system
  title       String
  body        String    @default("")
  urgency     String    @default("normal")  // normal | urgent
  routineSlug String?
  link        String?
  sentVia     String    @default("none")    // none | sms | digest
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Per-user notification preferences (one row per user).
model NotificationSettings {
  id          String  @id @default(cuid())
  userId      String  @unique
  digestMode  String  @default("weekly")  // weekly | off
  digestDay   Int     @default(6)         // 0=Sun .. 6=Sat
  digestHour  Int     @default(15)        // local business time
  urgentSms   Boolean @default(true)
}

// ---------------------------------------------------------------------------
// SEO Growth Engine (backend/ai/seo/*). Paths are canonical site paths ("/blog-x", "/"):
// no host, no ".html", original case kept. Search Console days are Pacific time.
// ---------------------------------------------------------------------------

// Search Console [date] totals. Includes anonymized queries, so it is the source of the headline numbers.
model SeoDailyTotal {
  userId      String
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  final       Boolean  @default(false) // false = Google may still revise this day

  @@id([userId, date])
}

// Search Console [date, query, page]; kept SEO_STATS_RETENTION_DAYS (default 120), older history in SeoQueryMonth.
model SeoQueryStat {
  userId      String
  date        DateTime @db.Date
  query       String
  page        String
  clicks      Int
  impressions Int
  position    Float
  final       Boolean  @default(false)

  @@id([userId, date, query, page])
}

// Search Console [query, page] per calendar month: the 16-month backfill and history past retention.
model SeoQueryMonth {
  userId      String
  month       DateTime @db.Date // first day of the month
  query       String
  page        String
  clicks      Int
  impressions Int
  position    Float // impression-weighted

  @@id([userId, month, query, page])
}

// One keyword the business wants to win, with its lifecycle and the numbers that move it.
model SeoKeyword {
  id                  String    @id @default(cuid())
  userId              String
  keyword             String
  matchKey            String // keywords.matchKey(): dedup + query matching
  cluster             String // config.CLUSTERS id | brand | other
  intent              String    @default("informational") // transactional | commercial | informational
  kind                String    @default("blog") // blog | service | area: which kind of page should own it
  area                String? // neighbourhood for area keywords
  source              String    @default("seed") // seed | gsc | serper | import | owner | claude
  status              String    @default("idea") // idea|planned|assigned|published|indexed|ranking|page1|top3|stalled|retired
  statusChangedAt     DateTime  @default(now())
  pinned              Boolean   @default(false)
  rankTrack           Boolean   @default(false) // weekly Serper rank + map-pack check
  priority            Float     @default(0)
  scoreParts          Json? // {upside,stage,intent,season,confidence,clusterBoost,why}
  signals             Json? // Serper discovery: {autocomplete, paa, related, competitors[]}
  targetPath          String?
  clicks28            Int       @default(0)
  impressions28       Int       @default(0)
  position28          Float?
  baselinePosition    Float?
  baselineImpressions Int?
  baselineAt          DateTime?
  bestPosition        Float?
  bestPositionAt      DateTime?
  serpPosition        Int? // Serper organic rank (Winnipeg), null = not in top 30
  mapPackPosition     Int? // Serper places rank, null = not in the map pack
  serpCheckedAt       DateTime?
  history             Json? // weekly [{w,pos,imp,clk,serp,map}] capped at 80
  lockedUntil         DateTime?
  lockedBy            String?
  lastAssignedAt      DateTime?
  publishedAt         DateTime?
  notes               String    @default("")
  focus               Boolean   @default(false) // owner picked it for a full campaign (see ai/seo/focus.js)
  focusStatus         String? // active | paused | won | stopped
  focusSince          DateTime?
  focusGoal           Int       @default(3) // Google position the campaign is chasing
  supportsId          String? // set on supporting keywords: the focus keyword they build up
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, matchKey])
  @@index([userId, status])
  @@index([userId, cluster])
  @@index([userId, supportsId])
}

// One thing a focus campaign does or waits for. The Focus tab's checklist and timeline are these rows.
model SeoFocusStep {
  id        String    @id @default(cuid())
  userId    String
  keywordId String // the focus keyword
  kind      String // page | refresh | support | links | social
  status    String    @default("planned") // planned | queued | in_progress | done | skipped
  title     String
  detail    Json?
  refId     String? // supporting keyword id, content item id or assignment id
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, keywordId])
  @@index([userId, status])
}

// Every URL the engine knows about: from the crawl, the sitemaps, Search Console or a publish report.
model SeoPage {
  id                String    @id @default(cuid())
  userId            String
  path              String
  kind              String    @default("other") // home | service | area | blog | hub | other
  title             String?
  h1                String?
  primaryKeyword    String?
  secondaryKeywords Json?
  cluster           String?
  contentType       String?
  wordCount         Int?
  source            String    @default("crawl") // crawl | sitemap | gsc | published | owner
  inSitemap         Boolean   @default(false)
  sitemapUrl        String?
  inPostsJson       Boolean?
  inlinks           Int       @default(0)
  linkedFrom        Json? // paths of the pages that link here, from the last crawl
  httpStatus        Int?
  redirectTo        String?
  canonical         String?
  canonicalOk       Boolean?
  noindex           Boolean   @default(false)
  contentHash       String?
  contentChangedAt  DateTime?
  indexVerdict      String? // PASS | PARTIAL | FAIL | NEUTRAL (URL Inspection)
  coverageState     String?
  googleCanonical   String?
  lastCrawlTime     DateTime?
  lastInspectedAt   DateTime?
  indexedAt         DateTime?
  clicks28          Int       @default(0)
  impressions28     Int       @default(0)
  position28        Float?
  publishedAt       DateTime?
  refreshedAt       DateTime?
  lastCheckedAt     DateTime?
  excluded          Boolean   @default(false) // owner: not a real page; never in tasks
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, path])
  @@index([userId, kind])
}

// Live sitemap files and what Google says about them.
model SeoSitemap {
  id                String    @id @default(cuid())
  userId            String
  url               String
  isIndex           Boolean   @default(false)
  parentUrl         String?
  urlCount          Int       @default(0)
  contentHash       String?
  hashChangedAt     DateTime?
  submittedHash     String?
  httpStatus        Int?
  lastFetchedAt     DateTime?
  lastSubmittedAt   DateTime?
  gscLastSubmitted  DateTime?
  gscLastDownloaded DateTime?
  gscIsPending      Boolean?
  gscErrors         Int?
  gscWarnings       Int?
  gscSubmittedUrls  Int?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, url])
}

// One unit of work handed to the blog writer (new post, refresh or landing page). brief is frozen.
model SeoAssignment {
  id            String    @id @default(cuid())
  userId        String
  keywordId     String
  keywordText   String
  cluster       String?
  mode          String // new | refresh | page
  contentType   String?
  status        String    @default("reserved") // reserved | published | expired | skipped
  brief         Json
  targetPath    String?
  reservedBy    String?
  expiresAt     DateTime
  publishedPath String?
  publishedAt   DateTime?
  skipReason    String?
  createdAt     DateTime  @default(now())

  @@index([userId, status])
  @@index([userId, createdAt])
}

// Weekly recap shown on seo-growth.html. metrics is snapshotted by the server, the narrative by Claude.
model SeoProgressReport {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  narrative   String
  nextFocus   String   @default("")
  author      String   @default("content")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}
